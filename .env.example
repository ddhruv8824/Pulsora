# Claude API key. Leave empty to run Pulsora in DEMO mode (sample outputs, no AI calls).
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5)
# PULSORA_MODEL=claude-opus-5-5

# Online only: require this password before anyone can use the app (leave empty locally).
# DEMO_PASSWORD=

# Online only (Vercel): set automatically when a Vercel Blob store is connected.
# BLOB_READ_WRITE_TOKEN=
